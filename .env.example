# Variables de entorno de la app. Para levantar en local: copiá este archivo a `.env`.
# Sin valores secretos (ver AGENTS.md, regla 1): una variable secreta va como `NOMBRE=`, vacía;
# una que no es secreta y tiene un único valor válido en local lleva ese valor.
# El esquema que las valida al arrancar (Zod) está en src/infraestructura/entorno.ts: si una
# falta o es inválida, la app no arranca y el mensaje dice cuál.

# Dónde corre la app: local | ci | servidor.
APP_ENTORNO=local

# La base de datos: una URL postgresql:// (o postgres://). Sin ella no arranca ni la app ni
# `npm run db:migrate`. Este valor es el del Postgres local de docker-compose.yml
# (`docker compose up -d`): credenciales de desarrollo, ficticias y descartables, no un secreto.
# En el servidor lleva otra URL, con clave real, y NUNCA se escribe en este archivo.
DATABASE_URL=postgresql://seism:seism_local@localhost:5432/seism_gestion

# El email del primer administrador: `npm run db:seed` lo da de alta si no existe (F0-30). Sin él no
# arranca ni la app ni ningún script de base. Este es INVENTADO (dominio reservado `.test`): en tu
# `.env` y en el servidor va el email real de quien administra, que NUNCA se escribe en este archivo.
ADMIN_INICIAL_EMAIL=admin@ejemplo.test
