{
  "name": "seism-gestion",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de gestión de operaciones para una consultora de servicios a la minería (Fase 0).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "worker": "node src/worker/index.ts",
    "lint": "biome check . && node scripts/sin-error-crudo.ts && node scripts/sin-marcas-conflicto.ts",
    "test": "vitest run --project dominio --project casos-uso",
    "test:dominio": "node scripts/test-dominio.ts",
    "test:extraccion": "vitest run --project extraccion",
    "test:golden:update": "node scripts/test-golden-update.ts",
    "test:e2e": "playwright test",
    "test:todo": "vitest run && npm run test:e2e",
    "test:mutacion": "stryker run",
    "e2e:app": "node scripts/e2e-app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/sin-any.ts",
    "typecheck:fixtures": "node scripts/typecheck-fixtures.ts",
    "lint:fixtures": "node scripts/lint-fixtures.ts",
    "limites": "depcruise src tests scripts --config .dependency-cruiser.cjs",
    "limites:fixtures": "node scripts/limites-fixtures.ts",
    "verificar": "node scripts/verificar.ts",
    "imagen": "node scripts/imagen.ts construir",
    "imagen:prueba": "node scripts/imagen.ts probar",
    "postinstall": "prisma generate",
    "db:generar": "prisma generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:migrate:down": "node scripts/db-migrate-down.ts",
    "db:seed": "node scripts/db-seed.ts",
    "arrancar": "node scripts/arrancar.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@visx/axis": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "arctic": "3.7.0",
    "croner": "10.0.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
