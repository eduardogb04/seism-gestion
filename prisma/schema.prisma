// Esquema de la base (F0-08). Convenciones: docs/convenciones-base.md.
// Decisiones (Prisma, cliente generado, reversión): docs/adr/0008-prisma-y-reversion.md.
//
// Nadie toca la base a mano: todo cambio acá es una migración con su
// `down.sql` en `prisma/migrations/`. Nombres en la base en castellano y
// `snake_case` (`@@map`/`@map`); en TypeScript, `camelCase`.

// El cliente se genera adentro de `src/adaptadores/prisma/`, que es el único
// lugar del diseño donde puede vivir Prisma: dependency-cruiser no deja que
// `dominio`, `puertos` ni `casos-uso` lo importen. No se versiona (está en
// `.gitignore`): lo regenera `npm install`/`npm ci` (`postinstall`) o
// `npm run db:generar`, sin conectarse a ninguna base.
generator client {
  provider            = "prisma-client"
  output              = "../src/adaptadores/prisma/generado"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

// La URL no va acá: la da `prisma.config.ts` desde `DATABASE_URL`.
datasource db {
  provider = "postgresql"
}

// Parámetros del sistema que se cambian sin redeploy (por ejemplo, el tope de
// gasto de IA del lote 7). Una fila por clave.
model Configuracion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave          String   @unique
  valor          String
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  // Quién la cambió por última vez. Nullable hasta que existan usuarios
  // (lote 8), que la va a ligar a `usuarios`.
  actualizadoPor String?  @map("actualizado_por") @db.Uuid

  @@map("configuracion")
}

// Registro de uso de IA (F0-28, ADR 0026): una fila por cada vez que el caso
// de uso `interpretar` le preguntó al adaptador de IA, escrita **antes** de
// devolver la propuesta (o de rechazarla por inválida). La IA nunca escribe
// en el dominio: su propuesta queda acá y la decisión humana la completa
// Fase 1 (`decision_humana`, `decidido_por`, `decidido_en`, nulos al crear).
model UsoIa {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Cuándo se preguntó, según el reloj inyectado.
  en              DateTime  @db.Timestamptz(3)
  perfil          String
  modelo          String
  versionPrompt   String    @map("version_prompt")
  // Dólares con seis decimales: en el código, micro-dólares enteros (R5).
  costoUsd        Decimal   @map("costo_usd") @db.Decimal(14, 6)
  tokens          Int
  // La salida del adaptador tal cual llegó, haya validado o no.
  propuesta       Json
  // Si la salida pasó el esquema Zod del que llamó (si no, `IA-0002`).
  propuestaValida Boolean   @map("propuesta_valida")
  decisionHumana  String?   @map("decision_humana")
  // Nullable hasta que existan usuarios (lote 8), igual que en `configuracion`.
  decididoPor     String?   @map("decidido_por") @db.Uuid
  decididoEn      DateTime? @map("decidido_en") @db.Timestamptz(3)

  // El tope suma el gasto de un mes: se busca por `en`.
  @@index([en])
  @@map("uso_ia")
}
