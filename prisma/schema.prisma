// Esquema de la base (F0-08). Convenciones: docs/convenciones-base.md.
// Decisiones (Prisma, cliente generado, reversión): docs/adr/0008-prisma-y-reversion.md.
//
// Nadie toca la base a mano: todo cambio acá es una migración con su
// `down.sql` en `prisma/migrations/`. Nombres en la base en castellano y
// `snake_case` (`@@map`/`@map`); en TypeScript, `camelCase`.

// El cliente se genera adentro de `src/adaptadores/prisma/`, que es el único
// lugar del diseño donde puede vivir Prisma: dependency-cruiser no deja que
// `dominio`, `puertos` ni `casos-uso` lo importen. No se versiona (está en
// `.gitignore`): lo regenera `npm install`/`npm ci` (`postinstall`) o
// `npm run db:generar`, sin conectarse a ninguna base.
generator client {
  provider            = "prisma-client"
  output              = "../src/adaptadores/prisma/generado"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  // El índice parcial de los fallidos pendientes (F0-25, ADR 0025).
  previewFeatures     = ["partialIndexes"]
}

// La URL no va acá: la da `prisma.config.ts` desde `DATABASE_URL`.
datasource db {
  provider = "postgresql"
}

// Parámetros del sistema que se cambian sin redeploy (por ejemplo, el tope de
// gasto de IA del lote 7). Una fila por clave.
model Configuracion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave          String   @unique
  valor          String
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  // Quién la cambió por última vez: un usuario (F0-30). Nullable: la semilla
  // escribe los valores por defecto sin que los cambie ninguna persona.
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  actualizador   Usuario? @relation(fields: [actualizadoPor], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("configuracion")
}

// Registro de uso de IA (F0-28, ADR 0026): una fila por cada vez que el caso
// de uso `interpretar` le preguntó al adaptador de IA, escrita **antes** de
// devolver la propuesta (o de rechazarla por inválida). La IA nunca escribe
// en el dominio: su propuesta queda acá y la decisión humana la completa
// Fase 1 (`decision_humana`, `decidido_por`, `decidido_en`, nulos al crear).
model UsoIa {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Cuándo se preguntó, según el reloj inyectado.
  en              DateTime  @db.Timestamptz(3)
  perfil          String
  modelo          String
  versionPrompt   String    @map("version_prompt")
  // Dólares con seis decimales: en el código, micro-dólares enteros (R5).
  costoUsd        Decimal   @map("costo_usd") @db.Decimal(14, 6)
  tokens          Int
  // La salida del adaptador tal cual llegó, haya validado o no.
  propuesta       Json
  // Si la salida pasó el esquema Zod del que llamó (si no, `IA-0002`).
  propuestaValida Boolean   @map("propuesta_valida")
  decisionHumana  String?   @map("decision_humana")
  // Nullable hasta que existan usuarios (lote 8), igual que en `configuracion`.
  decididoPor     String?   @map("decidido_por") @db.Uuid
  decididoEn      DateTime? @map("decidido_en") @db.Timestamptz(3)

  // El tope suma el gasto de un mes: se busca por `en`.
  @@index([en])
  @@map("uso_ia")
}

// Cómo terminó una corrida de un job del worker (F0-25).
enum ResultadoCorrida {
  ok
  error

  @@map("resultado_corrida")
}

// Una fila por corrida de cada job del worker (F0-25, ADR 0025). Se inserta
// con `inicio` antes de correr el job; `fin` y `resultado` se ponen al
// terminar, pase lo que pase. Una fila sin `fin` es una corrida en curso (o un
// proceso que murió a mitad). `inicio` hace de `creado_en`.
model CorridaWorker {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job       String
  inicio    DateTime          @db.Timestamptz(3)
  fin       DateTime?         @db.Timestamptz(3)
  resultado ResultadoCorrida?
  // Con error: el código del catálogo y el mensaje, redactado.
  detalle   String?

  // La última corrida de cada job (lo que lee `listarSalud`).
  @@index([job, inicio(sort: Desc)])
  @@map("corridas_worker")
}

// Lo que falló después de agotar los reintentos (F0-25, ADR 0025): "nada
// falla en silencio". Queda hasta que alguien lo resuelve (`resuelto_en`).
model Fallido {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Quién falló: la integración o la operación (por ejemplo, `ingesta.correo`).
  origen         String
  // El código del catálogo del último error.
  codigoError    String    @map("codigo_error")
  // Lo necesario para volver a intentarlo. Nunca un secreto.
  carga          Json      @db.JsonB
  intentos       Int
  // Cuándo volver a intentarlo. Nulo: nadie lo reintenta solo (Fase 0).
  proximoIntento DateTime? @map("proximo_intento") @db.Timestamptz(3)
  resueltoEn     DateTime? @map("resuelto_en") @db.Timestamptz(3)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // Los pendientes (los que cuenta `listarSalud`), sin recorrer los resueltos.
  @@index([resueltoEn], map: "fallidos_pendientes_idx", where: raw("resuelto_en IS NULL"))
  @@map("fallidos")
}

// Usuarios, sesiones y auditoría (F0-30, ADR 0024).

enum RolUsuario {
  administrador
  operador

  @@map("rol_usuario")
}

enum EstadoUsuario {
  activo
  revocado

  @@map("estado_usuario")
}

// La lista blanca (P4): solo entra quien tiene una fila `activo` acá. Un
// usuario nunca se borra: revocarlo es `estado = revocado`.
//
// `email` se guarda **siempre en minúsculas** (lo normalizan los casos de
// uso y el adaptador): así el índice único no distingue mayúsculas.
// `creado_por`, `actualizado_por` y `eliminado_por` guardan un `Actor`
// (persona o proceso del sistema) como `jsonb`: el primer administrador lo
// crea la semilla, que no es una persona. Las fechas las pone el reloj
// inyectado, no la base (por eso no hay `@updatedAt`).
model Usuario {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String        @unique
  // Se completa al primer ingreso (F0-31); el alta solo pide email y rol.
  nombre         String?
  rol            RolUsuario
  estado         EstadoUsuario @default(activo)
  creadoEn       DateTime      @map("creado_en") @db.Timestamptz(3)
  creadoPor      Json          @map("creado_por") @db.JsonB
  actualizadoEn  DateTime      @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor Json          @map("actualizado_por") @db.JsonB
  eliminadoEn    DateTime?     @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor   Json?         @map("eliminado_por") @db.JsonB

  sesiones               Sesion[]
  configuracionesTocadas Configuracion[]

  @@map("usuarios")
}

// Una sesión abierta. El `id` es el token: 256 bits aleatorios de
// `node:crypto` en base64url (43 caracteres), nunca un UUID. Una sesión no es
// un dato de negocio: cerrarla borra la fila (ADR 0024).
model Sesion {
  id        String   @id
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creadaEn  DateTime @map("creada_en") @db.Timestamptz(3)
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(3)
  ultimoUso DateTime @map("ultimo_uso") @db.Timestamptz(3)
  // El agente de usuario del navegador, si vino.
  agente    String?

  @@index([usuarioId])
  @@map("sesiones")
}

// El historial de auditoría: una fila por `RegistroAuditoria`
// (src/dominio/compartido/auditable.ts). Solo crece: el adaptador no tiene
// UPDATE ni DELETE.
model Auditoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidad   String
  entidadId String   @map("entidad_id")
  accion    String
  antes     Json?    @db.JsonB
  despues   Json?    @db.JsonB
  actor     Json     @db.JsonB
  en        DateTime @db.Timestamptz(3)

  @@index([entidad, entidadId])
  @@map("auditoria")
}

// Grupos (F1-03): el primer catálogo que sale del molde de ABM (ADR 0031).
// Las columnas de auditable son las de `usuarios`. El nombre es único entre
// los no eliminados y sin distinguir mayúsculas: lo garantiza el índice
// `grupos_nombre_unico`, sobre `lower(nombre)`, que vive solo en la migración
// (Prisma no declara índices sobre expresiones).
model Grupo {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  observaciones  String?
  creadoEn       DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor      Json      @map("creado_por") @db.JsonB
  actualizadoEn  DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor Json      @map("actualizado_por") @db.JsonB
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor   Json?     @map("eliminado_por") @db.JsonB
  clientes       Cliente[]

  @@map("grupos")
}

// Clientes y proveedores (F1-04), segundo catálogo del molde de ABM. Lo que
// pide una factura es obligatorio. La razón social (sin distinguir mayúsculas)
// y el CUIT son únicos entre los no eliminados: lo garantizan los índices
// `clientes_razon_social_unico` y `clientes_cuit_unico`, solo en la migración
// (Prisma no declara índices sobre expresiones). La condición frente al IVA y
// la provincia son texto: su lista vive en la definición del ABM.
model Cliente {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razonSocial      String    @map("razon_social")
  cuit             String
  condicionIva     String    @map("condicion_iva")
  domicilio        String
  localidad        String
  provincia        String
  codigoPostal     String    @map("codigo_postal")
  esCliente        Boolean   @map("es_cliente")
  esProveedor      Boolean   @map("es_proveedor")
  nombreCorto      String?   @map("nombre_corto")
  grupoId          String?   @map("grupo_id") @db.Uuid
  grupo            Grupo?    @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  contactoNombre   String?   @map("contacto_nombre")
  contactoTelefono String?   @map("contacto_telefono")
  contactoEmail    String?   @map("contacto_email")
  emailFacturacion String?   @map("email_facturacion")
  observaciones    String?
  creadoEn         DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor        Json      @map("creado_por") @db.JsonB
  actualizadoEn    DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor   Json      @map("actualizado_por") @db.JsonB
  eliminadoEn      DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor     Json?     @map("eliminado_por") @db.JsonB
  sitios           Sitio[]
  camiones         Camion[]

  @@map("clientes")
}

// Sitios (F1-05): donde está la instalación de un cliente. Los tanques no son
// entidades: el sitio lleva la cantidad y la capacidad total, y cómo cambian
// se lee de `auditoria`. El nombre es único dentro del cliente, entre los no
// eliminados y sin distinguir mayúsculas: lo garantiza el índice
// `sitios_cliente_id_nombre_unico`, solo en la migración (Prisma no declara
// índices sobre expresiones).
model Sitio {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId            String    @map("cliente_id") @db.Uuid
  cliente              Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  nombre               String
  provincia            String
  localidad            String
  direccion            String?
  latitud              Float?
  longitud             Float?
  cantidadTanques      Int       @map("cantidad_tanques")
  capacidadTotalLitros Int       @map("capacidad_total_litros")
  observaciones        String?
  creadoEn             DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor            Json      @map("creado_por") @db.JsonB
  actualizadoEn        DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor       Json      @map("actualizado_por") @db.JsonB
  eliminadoEn          DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor         Json?     @map("eliminado_por") @db.JsonB

  @@map("sitios")
}

// Camiones (F1-06): uno por uno, cuelgan del cliente. La patente del tractor es
// única y la de la cisterna también, pero solo entre las que la tienen (un
// chasis no lleva): las dos, entre los no eliminados y sin distinguir
// mayúsculas, por los índices `camiones_patente_tractor_unico` y
// `camiones_patente_cisterna_unico`, solo en la migración.
model Camion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId       String    @map("cliente_id") @db.Uuid
  cliente         Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo            String
  patenteTractor  String    @map("patente_tractor")
  marcaTractor    String    @map("marca_tractor")
  anioTractor     Int       @map("anio_tractor")
  patenteCisterna String?   @map("patente_cisterna")
  marcaCisterna   String?   @map("marca_cisterna")
  anioCisterna    Int?      @map("anio_cisterna")
  capacidadLitros Int       @map("capacidad_litros")
  observaciones   String?
  creadoEn        DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor       Json      @map("creado_por") @db.JsonB
  actualizadoEn   DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor  Json      @map("actualizado_por") @db.JsonB
  eliminadoEn     DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor    Json?     @map("eliminado_por") @db.JsonB

  @@map("camiones")
}

model TipoServicio {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  descripcion    String?
  modalidad      String
  activo         Boolean
  creadoEn       DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor      Json      @map("creado_por") @db.JsonB
  actualizadoEn  DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor Json      @map("actualizado_por") @db.JsonB
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor   Json?     @map("eliminado_por") @db.JsonB

  @@map("tipos_servicio")
}

model Cuenta {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  tipo           String
  moneda         String
  observaciones  String?
  activa         Boolean
  creadoEn       DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor      Json      @map("creado_por") @db.JsonB
  actualizadoEn  DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor Json      @map("actualizado_por") @db.JsonB
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor   Json?     @map("eliminado_por") @db.JsonB

  @@map("cuentas")
}

model CentroCosto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  clase          String
  descripcion    String?
  activo         Boolean
  creadoEn       DateTime  @map("creado_en") @db.Timestamptz(3)
  creadoPor      Json      @map("creado_por") @db.JsonB
  actualizadoEn  DateTime  @map("actualizado_en") @db.Timestamptz(3)
  actualizadoPor Json      @map("actualizado_por") @db.JsonB
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPor   Json?     @map("eliminado_por") @db.JsonB

  @@map("centros_costo")
}
